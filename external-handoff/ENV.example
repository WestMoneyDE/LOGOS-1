# Root
LOGOS_EXT_ROOT=$HOME/logos-external

# MBE
BEHAVIORAL_LIFT_LLM_FILE=/absolute/path/behavioral-lift-llm.parquet

# LongMemEval-V2
LONGMEM_REPO=$LOGOS_EXT_ROOT/src/LongMemEval-V2
LONGMEM_DATA_ROOT=$LOGOS_EXT_ROOT/data/longmemeval-v2
READER_BASE_URL=http://localhost:8023/v1
LME_CONTROLLER_BASE_URL=http://localhost:8023/v1
LME_EMBEDDING_BASE_URL=http://localhost:8114/v1
# OPENAI_API_KEY=SET_IN_SHELL_ONLY

# ENF
SAFE_CONTROL_GYM_REPO=$LOGOS_EXT_ROOT/src/safe-control-gym

# WMR
ARC_AGI_REPO=$LOGOS_EXT_ROOT/src/ARC-AGI
ARC_ENVIRONMENT_FILES=/absolute/path/environment_files

# TCV
TCV_ARTIFACT=/absolute/path/reproducibility_artifact.zip
TCV_GPT_OSS_BASE_URL=
TCV_GEMMA_BASE_URL=
TCV_EVALUATOR_BASE_URL=

# SkillsBench
SKILLSBENCH_REPO=$LOGOS_EXT_ROOT/src/skillsbench
MF_AGENT=codex-acp
MF_MODEL=
MF_SANDBOX=docker

# SCB P×R
SKILL_USAGE_REPO=$LOGOS_EXT_ROOT/src/Skill-Usage
REPLAY_AGENT_REPO=$LOGOS_EXT_ROOT/src/replay-agent-recorder
SCB_SKILL_POOL_ROOT=/absolute/path/skills
SCB_RETRIEVED_TB2_ROOT=/absolute/path/retrieved-terminalbench2
SCB_COMMON_MODEL=
SCB_COMMON_HARNESS=
# Set provider credentials only in the shell/session; never commit them.
